@page "/markdown-documents"
@using System.Linq
@using LightRAGNet.Services.Utilities
@using LightRAGNet.Web.Services
@inject ApiClient ApiClient
@inject RagTaskNotificationService NotificationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<MarkdownDocuments> Logger
@implements IAsyncDisposable

<PageTitle>Markdown Document List</PageTitle>

<MudContainer>
    <MudText Typo="Typo.h4" Class="mb-4">Markdown Document List</MudText>

    <MudSelect T="string"
               Label="Status"
               Value="_selectedStatusFilter"
               ValueChanged="OnStatusFilterChanged"
               Dense="true"
               Variant="Variant.Outlined"
               Clearable="true"
               Class="mb-3"
               Style="max-width: 240px;">
        @foreach (var status in StatusFilterOptions)
        {
            <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
        }
    </MudSelect>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
    }
    else if (_documents == null || !_documents.Any())
    {
        <MudAlert Severity="Severity.Info" Class="my-4">
            No documents yet, please upload documents first.
        </MudAlert>
    }
    else
    {
        <MudTable @ref="_tableRef"
                  Items="@_documents"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="2"
                  ServerData="@ServerReload"
                  TotalItems="@_totalCount"
                  RowsPerPage="@_pageSize">
            <HeaderContent>
                <MudTh>File Name</MudTh>
                <MudTh>File Size</MudTh>
                <MudTh>Upload Time</MudTh>
                <MudTh>RAG Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="File Name">
                    <MudText>@context.FileName</MudText>
                </MudTd>
                <MudTd DataLabel="File Size">
                    <MudText>@context.FileSize.FormatFileSize()</MudText>
                </MudTd>
                <MudTd DataLabel="Upload Time">
                    <MudText>@context.UploadTime.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudTd>
                <MudTd DataLabel="RAG Status">
                    @if (!string.IsNullOrEmpty(context.RagStatus))
                    {
                        <MudChip T="string" Size="Size.Small" Color="@context.RagStatus.GetRagStatusColor()"
                                 Icon="@context.RagStatus.GetRagStatusIcon()">
                            @context.RagStatus.GetRagStatusText(context.RagCurrentStage)
                        </MudChip>
                        @* Show progress bar and percentage in ProcessingChunks, MergingEntities, MergingRelations stages *@
                        @if (context is { RagStatus: "Processing" } && 
                             (context.RagCurrentStage == "ProcessingChunks" || 
                              context.RagCurrentStage == "MergingEntities" || 
                              context.RagCurrentStage == "MergingRelations"))
                        {
                            <MudProgressLinear Color="Color.Primary" Value="@context.RagProgress" Class="mt-1"/>
                            <MudText Typo="Typo.caption" Class="mt-1">@context.RagProgress%</MudText>
                        }

                        @if (context.RagStatus == "DeletionFailed" && !string.IsNullOrWhiteSpace(context.RagErrorMessage))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">
                                Error: @GetShortErrorMessage(context.RagErrorMessage)
                            </MudText>
                        }

                        @if (context.RagAddedTime.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1">
                                Added Time: @context.RagAddedTime.Value.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            Not Added
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudTooltip Text="View">
                        <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => ViewDocument(context.Id))" 
                                       Size="Size.Small" />
                    </MudTooltip>
                    @if (!string.IsNullOrEmpty(context.FileUrl))
                    {
                        <MudTooltip Text="Download">
                            <MudIconButton Color="Color.Info"
                                           Icon="@Icons.Material.Filled.Download"
                                           Href="@GetDownloadUrl(context.FileUrl)"
                                           Target="_blank"
                                           Size="Size.Small" />
                        </MudTooltip>
                    }
                    @if (!context.IsInRagSystem)
                    {
                        <MudTooltip Text="Add to RAG">
                            <MudIconButton Color="Color.Success" Icon="@Icons.Material.Filled.AddCircle"
                                           OnClick="@(() => AddToRagSystem(context.Id))"
                                           Disabled="@(context.RagStatus is "Processing" or "Pending" or "Queued")"
                                           Size="Size.Small" />
                        </MudTooltip>
                    }
                    @if (CanRetryDocument(context))
                    {
                        <MudTooltip Text="Retry">
                            <MudIconButton Color="Color.Warning" Icon="@Icons.Material.Filled.Refresh"
                                           OnClick="@(() => RetryDocument(context))"
                                           Size="Size.Small" />
                        </MudTooltip>
                    }
                    @if (CanCancelDocumentPipeline(context))
                    {
                        <MudTooltip Text="Cancel Pipeline">
                            <MudIconButton Color="Color.Warning" Icon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => CancelDocumentPipeline(context))"
                                           Size="Size.Small" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="Delete">
                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteDocument(context))"
                                       Disabled="@IsDocumentBusy(context)"
                                       Size="Size.Small" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager/>
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<MarkdownDocumentDto>? _documents;
    private bool _loading = true;
    private int _pageSize = 10;
    private int _totalCount;
    private bool _isInitialized;
    private MudTable<MarkdownDocumentDto>? _tableRef;
    private string? _selectedStatusFilter;
    private static readonly string[] StatusFilterOptions = ["Queued", "Processing", "Completed", "Failed", "Cancelled"];
    
    // Debounce executor related fields
    private readonly AsyncDebouncer _reloadDebouncer = new();
    private readonly TimeSpan _debounceDelay = TimeSpan.FromMilliseconds(240); // Debounce delay time: 240ms

    private enum DocumentRefreshReason
    {
        DataCleared,
        DeleteCompleted,
        CurrentPageDepleted,
        TaskStatusFinalized,
        UserAction
    }

    protected override async Task OnInitializedAsync()
    {
        // Ensure SignalR connection is initialized (managed by MainLayout, here only ensure connection)
        // If connection is not established, try to initialize (but won't duplicate initialization)
        if (!NotificationService.IsConnected)
        {
            try
            {
                await NotificationService.InitializeAsync();
            }
            catch
            {
                // Initialization failure does not affect page loading, connection status will be shown in MainLayout
            }
        }
        
        // Only subscribe to events on first initialization
        if (!_isInitialized)
        {
            _isInitialized = true;
           
            // Subscribe to task status update events
            NotificationService.TaskStatusUpdated += OnTaskStatusUpdated;
            // Subscribe to data cleared events
            NotificationService.DataCleared += OnDataCleared;
            
            var response = await ApiClient.GetMarkdownDocumentsAsync(0, _pageSize, status: _selectedStatusFilter);

            if (response != null)
            {
                _documents = response.Items;
                _totalCount = response.TotalCount;
            }
            else
            {
                _documents = [];
                _totalCount = 0;
            }
            _loading = false;
        }
    }

    private async Task OnDataCleared(object? sender, EventArgs e)
    {
        // After data is cleared, trigger MudTable to reload data
        await InvokeAsync(async () =>
        {
            _documents = [];
            _totalCount = 0;
            await RefreshDocumentsAsync(DocumentRefreshReason.DataCleared);
        });
    }

    private async Task OnTaskStatusUpdated(object? sender, TaskStatusUpdate update)
    {
        if (update.OperationType == "DeleteDocument")
        {
            await InvokeAsync(async () => await HandleDeleteTaskStatusUpdateAsync(update));
            return;
        }

        await InvokeAsync(async () => await HandleIndexTaskStatusUpdateAsync(update));
    }

    private async Task HandleDeleteTaskStatusUpdateAsync(TaskStatusUpdate update)
    {
        if (update.Status == "Completed")
        {
            RemoveDocumentFromCurrentPage(update.DocumentId);
            await RefreshDocumentsAsync(DocumentRefreshReason.DeleteCompleted);
            return;
        }

        var oldStatus = ApplyTaskStatusUpdate(update);
        if (oldStatus is null)
        {
            return;
        }

        if (update.Status == "Failed")
        {
            Snackbar.Add($"Document deletion failed: {GetShortErrorMessage(update.ErrorMessage)}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task HandleIndexTaskStatusUpdateAsync(TaskStatusUpdate update)
    {
        var oldStatus = ApplyTaskStatusUpdate(update);
        if (oldStatus is null)
        {
            if (ShouldRefreshForMissingTaskStatus(update, _selectedStatusFilter))
            {
                await RefreshDocumentsAsync(DocumentRefreshReason.TaskStatusFinalized);
            }

            return;
        }

        if (ShouldRefreshForTaskStatus(update, oldStatus, _selectedStatusFilter))
        {
            await RefreshDocumentsAsync(DocumentRefreshReason.TaskStatusFinalized);
            return;
        }

        StateHasChanged();
    }

    private async Task<TableData<MarkdownDocumentDto>> ServerReload(TableState state, CancellationToken cancellationToken = default)
    {
        try
        {
            _loading = true;

            var response = await ApiClient.GetMarkdownDocumentsAsync(state.Page + 1, state.PageSize, cancellationToken, status: _selectedStatusFilter);

            if (response != null)
            {
                _documents = response.Items;
                _totalCount = response.TotalCount;
            }
            else
            {
                _documents = [];
                _totalCount = 0;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            Logger.LogDebug("Document list reload was cancelled");
        }
        catch (HttpRequestException ex) when 
            (ex.InnerException is System.Net.Sockets.SocketException { SocketErrorCode: System.Net.Sockets.SocketError.ConnectionRefused })
        {
            Snackbar.Add("Cannot connect to Server application, please ensure LightRAGNet.Server is started", Severity.Warning);
            _documents = [];
            _totalCount = 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load markdown document list");
            Snackbar.Add($"Failed to load document list: {ex.Message}", Severity.Error);
            _documents = [];
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
        }

        return new TableData<MarkdownDocumentDto>
        {
            Items = _documents ?? [],
            TotalItems = _totalCount
        };
    }

    private async Task ViewDocument(int id)
    {
        try
        {
            var document = await ApiClient.GetMarkdownDocumentAsync(id);

            if (document != null)
            {
                var parameters = new DialogParameters
                {
                    { "Document", document }
                };

                var options = new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    CloseButton = true
                };

                await DialogService.ShowAsync<MarkdownViewDialog>("View Document", parameters, options);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load markdown document: DocumentId={DocumentId}", id);
            Snackbar.Add($"Failed to load document: {ex.Message}", Severity.Error);
        }
    }

    private static bool IsDocumentBusy(MarkdownDocumentDto document)
    {
        return document.RagStatus is "Pending" or "Queued" or "Processing" or "Deleting";
    }

    private async Task OnStatusFilterChanged(string? status)
    {
        _selectedStatusFilter = string.IsNullOrWhiteSpace(status) ? null : status;

        if (_tableRef != null)
        {
            await RefreshDocumentsAsync(DocumentRefreshReason.UserAction);
            return;
        }

        await ReloadCurrentPageAsync();
    }

    private static string GetDeleteConfirmationMessage(MarkdownDocumentDto document)
    {
        if (document.RagStatus == "DeletionFailed")
        {
            return "Retry deletion from RAG storage and then remove the local document record?";
        }

        if (document.IsInRagSystem)
        {
            return "This will remove the document from RAG storage and then delete the local document record.";
        }

        return "Are you sure you want to delete this local document?";
    }

    private static string GetShortErrorMessage(string? errorMessage)
    {
        if (string.IsNullOrWhiteSpace(errorMessage))
            return "Unknown error";

        const int maxLength = 120;
        return errorMessage.Length <= maxLength
            ? errorMessage
            : $"{errorMessage[..maxLength]}...";
    }

    private async Task DeleteDocument(MarkdownDocumentDto document)
    {
        var documentId = document.Id;
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            GetDeleteConfirmationMessage(document),
            yesText: "Delete",
            cancelText: "Cancel");

        if (_documents == null)
            return;

        if (result == true)
        {
            MarkdownDocumentDto? currentDocument = null;
            string? previousStatus = null;
            string? previousErrorMessage = null;
            var localStateChanged = false;

            try
            {
                currentDocument = _documents.FirstOrDefault(d => d.Id == documentId);
                if (currentDocument == null)
                {
                    Snackbar.Add("Document is no longer available", Severity.Info);
                    return;
                }

                previousStatus = currentDocument.RagStatus;
                previousErrorMessage = currentDocument.RagErrorMessage;
                currentDocument.RagStatus = "Deleting";
                currentDocument.RagErrorMessage = null;
                localStateChanged = true;
                StateHasChanged();

                var deleteResult = await ApiClient.DeleteMarkdownDocumentAsync(currentDocument.Id);

                if (deleteResult.DeletedImmediately)
                {
                    RemoveDocumentFromCurrentPage(currentDocument.Id);
                    localStateChanged = false;
                    Snackbar.Add("Document deleted successfully", Severity.Success);

                    var remainingCount = await ApiClient.GetMarkdownDocumentsCountAsync();
                    if (_documents.Count == 0 && remainingCount > 0)
                    {
                        // Use debounce mechanism to trigger MudTable to reload data (will automatically jump to appropriate page)
                        await RefreshDocumentsAsync(DocumentRefreshReason.CurrentPageDepleted);
                    }
                    else
                    {
                        // If current page still has data, only update UI
                        StateHasChanged();
                    }
                }
                else if (deleteResult.Accepted)
                {
                    Snackbar.Add("Document deletion queued", Severity.Info);
                    StateHasChanged();
                }
                else if (deleteResult.Conflict)
                {
                    RestoreDocumentDeletionState(currentDocument, previousStatus, previousErrorMessage);
                    Snackbar.Add("Document has an active RAG task", Severity.Warning);
                    StateHasChanged();
                }
                else
                {
                    RestoreDocumentDeletionState(currentDocument, previousStatus, previousErrorMessage);
                    Snackbar.Add($"Failed to delete document: {deleteResult.ErrorMessage}", Severity.Error);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                if (localStateChanged && currentDocument != null)
                {
                    RestoreDocumentDeletionState(currentDocument, previousStatus, previousErrorMessage);
                    StateHasChanged();
                }

                Snackbar.Add($"Failed to delete document: {ex.Message}", Severity.Error);
            }
        }
    }

    private static void RestoreDocumentDeletionState(
        MarkdownDocumentDto document,
        string? previousStatus,
        string? previousErrorMessage)
    {
        document.RagStatus = previousStatus;
        document.RagErrorMessage = previousErrorMessage;
    }

    private void RemoveDocumentFromCurrentPage(int id)
    {
        if (_documents == null)
            return;

        var itemToRemove = _documents.FirstOrDefault(d => d.Id == id);
        if (itemToRemove == null)
            return;

        _documents.Remove(itemToRemove);
        _totalCount = Math.Max(0, _totalCount - 1);
    }

    private async Task AddToRagSystem(int id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Add to RAG System",
            "Are you sure you want to add this document to the RAG system?",
            yesText: "Confirm",
            cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var document = await ApiClient.AddToRagSystemAsync(id);

                if (document != null)
                {
                    ApplyAddToRagResult(id, document);
                    Snackbar.Add("Document added to RAG system, processing...", Severity.Success);
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add("Failed to add to RAG system", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to add to RAG system: {ex.Message}", Severity.Error);
            }
        }
    }

    private static bool CanRetryDocument(MarkdownDocumentDto document)
    {
        return document.RagStatus is "Failed" or "Cancelled";
    }

    private static bool CanCancelDocumentPipeline(MarkdownDocumentDto document)
    {
        return document.RagStatus is "Queued" or "Processing" or "Pending";
    }

    private async Task RetryDocument(MarkdownDocumentDto document)
    {
        try
        {
            var result = await ApiClient.RetryDocumentAsync(document.Id);
            if (result?.Accepted == true)
            {
                ApplyPipelineActionResult(document.Id, result);
                Snackbar.Add("Document retry queued", Severity.Success);
                StateHasChanged();
                await RefreshDocumentsAsync(DocumentRefreshReason.UserAction);
                return;
            }

            Snackbar.Add("Failed to retry document", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to retry document: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelDocumentPipeline(MarkdownDocumentDto document)
    {
        try
        {
            var result = await ApiClient.CancelDocumentPipelineAsync(document.Id);
            if (result?.Accepted == true)
            {
                ApplyPipelineActionResult(document.Id, result);
                Snackbar.Add("Document pipeline cancelled", Severity.Success);
                StateHasChanged();
                await RefreshDocumentsAsync(DocumentRefreshReason.UserAction);
                return;
            }

            Snackbar.Add("Failed to cancel document pipeline", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to cancel document pipeline: {ex.Message}", Severity.Error);
        }
    }

    private string GetDownloadUrl(string? fileUrl)
    {
        if (string.IsNullOrEmpty(fileUrl))
        {
            return "#";
        }

        // Get API base URL (from ApiClient's BaseAddress)
        var baseUrl = ApiClient.GetBaseAddress();
        return $"{baseUrl.TrimEnd('/')}{fileUrl}";
    }

    private string? ApplyTaskStatusUpdate(TaskStatusUpdate update)
    {
        var document = _documents?.FirstOrDefault(d => d.Id == update.DocumentId);
        if (document == null)
        {
            return null;
        }

        var oldStatus = document.RagStatus;
        if (update.OperationType == "DeleteDocument")
        {
            document.RagStatus = update.Status == "Failed" ? "DeletionFailed" : "Deleting";
            document.RagErrorMessage = update.ErrorMessage;
            document.RagCurrentStage = update.CurrentStage;
            return oldStatus;
        }

        document.RagStatus = update.Status;
        document.RagCurrentStage = update.CurrentStage;

        // Update progress in ProcessingChunks, MergingEntities, MergingRelations stages.
        // Other stages don't update progress, keep previous value.
        if (update.CurrentStage is "ProcessingChunks" or "MergingEntities" or "MergingRelations")
        {
            document.RagProgress = update.Progress;
        }

        if (update.Status == "Completed")
        {
            document.IsInRagSystem = true;
            document.RagAddedTime = update.CompletedAt ?? DateTime.UtcNow;
        }

        return oldStatus;
    }

    private static bool ShouldRefreshForTaskStatus(
        TaskStatusUpdate update,
        string? oldStatus,
        string? selectedStatusFilter)
    {
        if (!string.IsNullOrWhiteSpace(selectedStatusFilter) &&
            NormalizeFilterStatus(oldStatus) != NormalizeFilterStatus(update.Status))
        {
            return true;
        }

        return update.Status is "Completed" or "Failed" &&
               oldStatus is "Processing" or "Pending";
    }

    private static bool ShouldRefreshForMissingTaskStatus(
        TaskStatusUpdate update,
        string? selectedStatusFilter)
    {
        return !string.IsNullOrWhiteSpace(selectedStatusFilter) &&
               NormalizeFilterStatus(update.Status) == NormalizeFilterStatus(selectedStatusFilter);
    }

    private static string? NormalizeFilterStatus(string? status)
    {
        return status == "Pending" ? "Queued" : status;
    }

    private void ApplyAddToRagResult(int id, MarkdownDocumentDto document)
    {
        var localDocument = _documents?.FirstOrDefault(d => d.Id == id);
        if (localDocument == null)
        {
            return;
        }

        localDocument.RagStatus = document.RagStatus;
        localDocument.RagProgress = document.RagProgress;
        localDocument.IsInRagSystem = document.IsInRagSystem;
        localDocument.RagAddedTime = document.RagAddedTime;
        localDocument.RagErrorMessage = document.RagErrorMessage;
        localDocument.RagCurrentStage = document.RagCurrentStage;
    }

    private void ApplyPipelineActionResult(int id, DocumentPipelineActionResult result)
    {
        var localDocument = _documents?.FirstOrDefault(d => d.Id == id);
        if (localDocument == null)
        {
            return;
        }

        localDocument.RagStatus = result.Status;
        localDocument.RagErrorMessage = null;
        localDocument.RagCurrentStage = result.Status;
        localDocument.RagProgress = result.Status == "Queued" ? 0 : localDocument.RagProgress;
        localDocument.ActiveRagTaskId = result.Status == "Cancelled" ? null : localDocument.ActiveRagTaskId;
    }

    private async Task ReloadCurrentPageAsync()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            var response = await ApiClient.GetMarkdownDocumentsAsync(1, _pageSize, status: _selectedStatusFilter);

            if (response != null)
            {
                _documents = response.Items;
                _totalCount = response.TotalCount;
            }
            else
            {
                _documents = [];
                _totalCount = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load markdown document list");
            Snackbar.Add($"Failed to load document list: {ex.Message}", Severity.Error);
            _documents = [];
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Debounce executor: when multiple update requests are received within specified time, only execute the last update
    /// </summary>
    private async Task RefreshDocumentsAsync(DocumentRefreshReason reason)
    {
        Logger.LogDebug("Scheduling markdown document list refresh: Reason={Reason}", reason);
        await _reloadDebouncer.DebounceAsync(
            _debounceDelay,
            async cancellationToken =>
            {
                if (_tableRef != null && !cancellationToken.IsCancellationRequested)
                {
                    await _tableRef.ReloadServerData();
                }
            });
    }

    public async ValueTask DisposeAsync()
    {
        NotificationService.TaskStatusUpdated -= OnTaskStatusUpdated;
        NotificationService.DataCleared -= OnDataCleared;
        
        // Clean up debounce executor resources
        await _reloadDebouncer.DisposeAsync();
    }
}
