@page "/"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

<PageTitle>RAG Chat</PageTitle>

<link rel="stylesheet" href="rag-chat/assets/rag-chat.css" />

<div id="rag-chat-root" data-api-base="@ApiBase"></div>

@code {
    private const string RootElementId = "rag-chat-root";
    private IJSObjectReference? ragChatModule;
    private bool _disposed;
    private string ApiBase => Configuration["ApiBaseUrl"] ?? "http://localhost:5261";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        var importedModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./rag-chat/assets/rag-chat.js");

        if (_disposed)
        {
            await DisposeImportedModuleAsync(importedModule);
            return;
        }

        try
        {
            if (_disposed)
            {
                await DisposeImportedModuleAsync(importedModule);
                return;
            }

            await importedModule.InvokeVoidAsync("mountRagChat", RootElementId, ApiBase);
        }
        catch
        {
            await DisposeImportedModuleAsync(importedModule);
            throw;
        }

        if (_disposed)
        {
            await UnmountAndDisposeModuleAsync(importedModule);
            return;
        }

        ragChatModule = importedModule;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        var module = ragChatModule;
        if (module is null)
        {
            return;
        }

        ragChatModule = null;
        await UnmountAndDisposeModuleAsync(module);
    }

    private async ValueTask UnmountAndDisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("unmountRagChat", RootElementId);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit can be gone while Blazor is tearing down the page.
        }
        catch (ObjectDisposedException)
        {
            // The JS runtime may already be disposed during host shutdown.
        }
    }

    private static async ValueTask DisposeImportedModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit can be gone while Blazor is tearing down the page.
        }
        catch (ObjectDisposedException)
        {
            // The JS runtime may already be disposed during host shutdown.
        }
    }
}
