@page "/"
@using LightRAGNet.Core.Models
@using LightRAGNet.Services.Utilities
@using LightRAGNet.Share.Models
@using LightRAGNet.Web.Services
@using LightRAGNet.Web.Models
@inject ApiClient ApiClient
@inject ChatHistoryService ChatHistoryService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>RAG Chat</PageTitle>

<MudContainer Class="d-flex flex-column" Style="height: calc(100vh - 130px); max-width: 100%; overflow: hidden;">
    <MudPaper Elevation="1" Class="ma-1 d-flex align-center justify-space-between pa-2">
        <MudText Typo="Typo.h6">RAG Chat</MudText>
        <MudButton Variant="Variant.Text" 
                   Color="Color.Error" 
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Size="Size.Small"
                   OnClick="@ClearChatHistory"
                   Disabled="@_isWaitingResponse">
            Clear History
        </MudButton>
    </MudPaper>
    
    <div @ref="_chatContainer" style="flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0;">
        <MudPaper Elevation="1" Class="ma-1">
            @if (_chatHistory.Count == 0)
            {
                <MudText Typo="Typo.h6" Align="Align.Center" Class="pa-2">Start chatting with RAG</MudText>
            }
            else
            {
                <MudStack Spacing="2" Class="pa-3">
                    @foreach (var chatMessage in _chatHistory)
                    {
                        <div class="d-flex @(chatMessage.Role == "User" ? "justify-end" : "justify-start")">
                            <MudPaper Elevation="0"
                                      Class="@GetMessageBubbleClass(chatMessage)"
                                      Style="max-width: 78%; overflow-wrap: anywhere;">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@GetMessageSender(chatMessage)</MudText>
                                @if (chatMessage.Role == "Assistant")
                                {
                                    <MudMarkdown Value="@chatMessage.Text" />
                                    @if (string.IsNullOrEmpty(chatMessage.Text) && !chatMessage.IsComplete)
                                    {
                                        <MudProgressCircular Size="Size.Small" Color="Color.Default" Indeterminate="true"/>
                                    }
                                    @if (string.IsNullOrEmpty(chatMessage.Text) && chatMessage.IsComplete && string.IsNullOrWhiteSpace(chatMessage.ErrorMessage))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No content returned.</MudText>
                                    }
                                    @if (chatMessage.Mode is not null || !string.IsNullOrWhiteSpace(chatMessage.ErrorMessage))
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @if (chatMessage.Mode is { } mode)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@mode</MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="@(chatMessage.IsStreaming ? Color.Info : Color.Success)" Variant="Variant.Outlined">
                                                    @(chatMessage.IsStreaming ? "Streaming" : "Cacheable")
                                                </MudChip>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(chatMessage.ErrorMessage))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Error</MudChip>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(chatMessage.ErrorMessage))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@chatMessage.ErrorMessage</MudText>
                                    }
                                    @if (ShouldRenderReferences(chatMessage))
                                    {
                                        <MudExpansionPanels Elevation="0" Class="mt-2">
                                            <MudExpansionPanel Text="@($"References ({chatMessage.References.Count})")">
                                                <MudStack Spacing="1">
                                                    @foreach (var reference in chatMessage.References)
                                                    {
                                                        <MudText Typo="Typo.caption">
                                                            <strong>@reference.FilePath</strong>
                                                            @if (!string.IsNullOrWhiteSpace(reference.ReferenceId))
                                                            {
                                                                <span> · @reference.ReferenceId</span>
                                                            }
                                                        </MudText>
                                                    }
                                                </MudStack>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                    @if (ShouldRenderDiagnostics(chatMessage))
                                    {
                                        <MudExpansionPanels Elevation="0" Class="mt-2">
                                            <MudExpansionPanel Text="Diagnostics">
                                                @if (chatMessage.HighLevelKeywords.Count > 0)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">High</MudText>
                                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                                        @foreach (var keyword in chatMessage.HighLevelKeywords)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@keyword</MudChip>
                                                        }
                                                    </div>
                                                }
                                                @if (chatMessage.LowLevelKeywords.Count > 0)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Low</MudText>
                                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                                        @foreach (var keyword in chatMessage.LowLevelKeywords)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@keyword</MudChip>
                                                        }
                                                    </div>
                                                }
                                                @if (chatMessage.Diagnostics.Count > 0)
                                                {
                                                    <MudSimpleTable Dense="true" Hover="true">
                                                        <tbody>
                                                            @foreach (var diagnostic in chatMessage.Diagnostics)
                                                            {
                                                                <tr>
                                                                    <td><strong>@diagnostic.Key</strong></td>
                                                                    <td>@diagnostic.Value</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                }
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                }
                                else
                                {
                                    <MudText>@chatMessage.Text</MudText>
                                }
                            </MudPaper>
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>
    </div>

    <MudPaper Elevation="3" Class="mt-2">
        <MudGrid Spacing="2" Class="pa-2 pb-0">
            <MudItem xs="12" sm="4" md="2">
                <MudSelect T="QueryMode"
                           @bind-Value="_querySettings.SelectedMode"
                           Label="Mode"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Disabled="@_isWaitingResponse">
                    @foreach (var mode in _queryModes)
                    {
                        <MudSelectItem T="QueryMode" Value="@mode">@mode</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSwitch T="bool"
                           @bind-Value="_querySettings.StreamResponse"
                           Label="@(_querySettings.StreamResponse ? "Streaming" : "Cacheable")"
                           Color="Color.Primary"
                           Disabled="@_isWaitingResponse" />
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSwitch T="bool"
                           @bind-Value="_querySettings.EffectiveIncludeReferences"
                           Label="References"
                           Color="Color.Primary"
                           Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="Advanced">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" @bind-Value="_querySettings.TopK" Label="TopK" Min="1" Max="200" Variant="Variant.Outlined" Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" @bind-Value="_querySettings.ChunkTopK" Label="ChunkTopK" Min="1" Max="200" Variant="Variant.Outlined" Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_querySettings.ResponseType" Label="Response" Dense="true" Variant="Variant.Outlined" Disabled="@_isWaitingResponse">
                                    @foreach (var responseType in _responseTypes)
                                    {
                                        <MudSelectItem T="string" Value="@responseType">@responseType</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudCheckBox T="bool" @bind-Value="_querySettings.EnableRerank" Label="Rerank" Dense="true" Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
                            </MudItem>
                            <MudItem xs="12" sm="8">
                                <MudSelect T="ChatQueryDebugOutputMode"
                                           @bind-Value="_querySettings.DebugOutputMode"
                                           Label="Output"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Disabled="@_isWaitingResponse">
                                    @foreach (var outputMode in _debugOutputModes)
                                    {
                                        <MudSelectItem T="ChatQueryDebugOutputMode" Value="@outputMode">@GetDebugOutputModeText(outputMode)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_querySettings.HighLevelKeywordsText" Label="High keywords" Variant="Variant.Outlined" Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_querySettings.LowLevelKeywordsText" Label="Low keywords" Variant="Variant.Outlined" Disabled="@(_isWaitingResponse || !_querySettings.AreRagOptionsEnabled)" />
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>
        <div class="d-flex gap-3 align-end">
            <MudTextField @bind-Value="_inputMessage"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Disabled="_isWaitingResponse"
                          Immediate="true"
                          OnKeyDown="@HandleKeyPress"
                          Placeholder="Enter your question..."
                          Class="flex-grow-1"/>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.Send"
                       Size="Size.Large"
                       OnClick="@SendMessageAsync"
                       Disabled="@CanNotSendMessage">
                Send
            </MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private List<ChatMessageModel> _chatHistory = [];
    private string _inputMessage = string.Empty;
    private bool _isWaitingResponse;
    private ElementReference _chatContainer;
    private readonly AsyncOperationSlot _queryOperation = new();
    private IJSObjectReference? _jsModule;
    private bool _shouldScrollAfterRender;
    private readonly ChatQuerySettingsModel _querySettings = new();

    private static readonly QueryMode[] _queryModes =
    [
        QueryMode.Mix,
        QueryMode.Naive,
        QueryMode.Bypass,
        QueryMode.Local,
        QueryMode.Global,
        QueryMode.Hybrid
    ];

    private static readonly string[] _responseTypes =
    [
        "Multiple Paragraphs",
        "Single Paragraph",
        "Bullet Points",
        "Concise"
    ];

    private static readonly ChatQueryDebugOutputMode[] _debugOutputModes =
    [
        ChatQueryDebugOutputMode.Answer,
        ChatQueryDebugOutputMode.ContextOnly,
        ChatQueryDebugOutputMode.PromptOnly
    ];

    private bool CanNotSendMessage => string.IsNullOrWhiteSpace(_inputMessage) || _isWaitingResponse;

    private static string GetMessageSender(ChatMessageModel message)
    {
        return message.Role == "User" ? "User" : "RAG Assistant";
    }

    private static string GetMessageBubbleClass(ChatMessageModel message)
    {
        return message.Role == "User"
            ? "pa-3 rounded-lg mud-theme-primary"
            : "pa-3 rounded-lg mud-theme-surface";
    }

    private static string GetDebugOutputModeText(ChatQueryDebugOutputMode outputMode)
    {
        return outputMode switch
        {
            ChatQueryDebugOutputMode.ContextOnly => "Context only",
            ChatQueryDebugOutputMode.PromptOnly => "Prompt only",
            _ => "Answer"
        };
    }

    protected override void OnInitialized()
    {
        // Load chat history from service
        _chatHistory = ChatHistoryService.GetChatHistory();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/RagChat.razor.js");
            }
            catch
            {
                // Ignore JavaScript module load errors
            }
            await ScrollToBottomAsync();
        }
        
        // Scroll to bottom after render if requested (e.g., after user message is added)
        if (_shouldScrollAfterRender)
        {
            _shouldScrollAfterRender = false;
            await ScrollToBottomAsync();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            if (_jsModule != null)
            {
                await _jsModule.InvokeVoidAsync("scrollToBottom", _chatContainer);
            }
        }
        catch
        {
            // Ignore JavaScript errors
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", ShiftKey: false } && !CanNotSendMessage)
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (CanNotSendMessage)
            return;

        var userMessage = _inputMessage.Trim();
        if (string.IsNullOrWhiteSpace(userMessage))
            return;

        AsyncOperationSlot.Lease queryLease;
        try
        {
            queryLease = await _queryOperation.StartNewAsync();
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        // Clear input and lock UI immediately
        _inputMessage = string.Empty;
        _isWaitingResponse = true;
        var request = _querySettings.BuildRequest(userMessage);
        
        // Add user message to history
        var userChatMessage = new ChatMessageModel { Role = "User", Text = userMessage };
        _chatHistory.Add(userChatMessage);
        ChatHistoryService.AddMessage(userChatMessage);
        
        // Create and add empty assistant message immediately to show loading animation
        var assistantMessage = new ChatMessageModel
        {
            Role = "Assistant",
            Text = string.Empty,
            Mode = request.Mode,
            IsStreaming = request.Stream,
            IsCacheable = !request.Stream,
            HighLevelKeywords = [.. request.HighLevelKeywords],
            LowLevelKeywords = [.. request.LowLevelKeywords]
        };
        _chatHistory.Add(assistantMessage);
        ChatHistoryService.AddMessage(assistantMessage);
        
        // Update UI to show user message and loading animation
        _shouldScrollAfterRender = true;
        StateHasChanged();

        using (queryLease)
        {
            try
            {
                await ApiClient.QueryRagAsync(
                    request,
                    new RagQueryStreamHandlers
                    {
                        OnChunkReceived = async chunk =>
                        {
                            if (string.IsNullOrEmpty(chunk) || queryLease.Token.IsCancellationRequested)
                                return;

                            await InvokeAsync(async () =>
                            {
                                assistantMessage.Text += chunk;
                                await ScrollToBottomAsync();
                                StateHasChanged();
                            });
                        },
                        OnMetadataReceived = async metadataEvent =>
                        {
                            await InvokeAsync(() =>
                            {
                                ChatQuerySettingsModel.ApplyMetadata(assistantMessage, metadataEvent);
                                StateHasChanged();
                            });
                        }
                    },
                    queryLease.Token);

                assistantMessage.IsComplete = true;
                if (string.IsNullOrWhiteSpace(assistantMessage.Text))
                {
                    assistantMessage.Text = string.Empty;
                }

                StateHasChanged();
            }
            catch (RagQueryException ex)
            {
                assistantMessage.IsComplete = true;
                assistantMessage.ErrorMessage = ex.Message;
                if (string.IsNullOrWhiteSpace(assistantMessage.Text))
                {
                    assistantMessage.Text = $"Error: {ex.Message}";
                }

                Snackbar.Add($"Query failed: {ex.Message}", Severity.Error);
                StateHasChanged();
            }
            catch (OperationCanceledException) when (queryLease.Token.IsCancellationRequested)
            {
                assistantMessage.IsComplete = true;
                if (string.IsNullOrWhiteSpace(assistantMessage.Text))
                {
                    assistantMessage.ErrorMessage = "Cancelled";
                    assistantMessage.Text = "Cancelled";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                assistantMessage.IsComplete = true;
                assistantMessage.ErrorMessage = ex.Message;
                if (string.IsNullOrWhiteSpace(assistantMessage.Text))
                {
                    assistantMessage.Text = $"Error: {ex.Message}";
                }

                Snackbar.Add($"Query failed: {ex.Message}", Severity.Error);
                StateHasChanged();
            }
            finally
            {
                if (await _queryOperation.IsCurrentAsync(queryLease))
                {
                    _isWaitingResponse = false;
                }
            }
        }
    }

    private static bool ShouldRenderReferences(ChatMessageModel message)
    {
        return message.Role == "Assistant" && message.References.Count > 0;
    }

    private static bool ShouldRenderDiagnostics(ChatMessageModel message)
    {
        return message.Role == "Assistant"
            && (message.Diagnostics.Count > 0
                || message.HighLevelKeywords.Count > 0
                || message.LowLevelKeywords.Count > 0);
    }

    private void ClearChatHistory()
    {
        ChatHistoryService.ClearHistory();
        _chatHistory.Clear();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _queryOperation.DisposeAsync();
        
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
    }
}
